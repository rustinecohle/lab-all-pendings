#include <stdio.h>
#include <string.h>
#define MAX_ATTEMPTS 6
#define WORD_COUNT 25
const char dictionary[WORD_COUNT][10] = {
    "cat", "dog", "cow", "pig", "duck",
    "goat", "bear", "fox", "wolf", "fish",
    "lion", "deer", "frog", "crab", "hen",
    "bat", "rat", "owl", "ant", "bee",
    "seal", "swan", "tiger", "horse", "sheep"
};
void menu(void);
void instructions(void);
void displayHangman(int wrong);
void playgame(void);
int main()
{
    int input;

    int running =1;
    while(running){
        menu();
                int r = scanf("%d", &input);
        if(r == EOF)
            return 0;
        if(r != 1){
            int c;
            while((c = getchar()) != '\n' && c != EOF);
            input = 0;
        }
        if(input!=1 && input!=2 && input!=3 ){
            printf("invalid choice please enter between 1, 2, 3");
            continue;

        }
        switch (input)
        {
            case 1: playgame();
                    break;
            case 2: instructions();
                    break;
            case 3: printf("\nthanks for playing\n");
                    running =0;
                    break;
            default:printf("\ninvalid choice please try again\n");
                    break;
        }
    }

return 0;

}

